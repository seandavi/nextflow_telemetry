# systemd *user* unit: one `nf-etl tick` (docs/etl-runbook.md). Triggered by
# nf-etl.timer. Writes lake.cmgd.* in the shared cdsci lake through cdsci.lake;
# its credentials come from GCP Secret Manager via the user's gcloud login.
[Unit]
Description=cMD output-catalog ETL tick
After=network-online.target
Wants=network-online.target
OnFailure=ntfy-notify@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/git/nextflow_telemetry
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CU_OPENALEX_LAKE_BACKEND=postgres
# Optional overrides (NF_TELEMETRY_URL, CU_OPENALEX_DUCKDB_*) live here.
EnvironmentFile=-%h/.config/nf-etl/env
ExecStart=%h/.local/bin/uv run --frozen nf-etl tick
TimeoutStartSec=14400
Nice=10
