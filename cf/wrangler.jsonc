{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nf-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  // Required by @cloudflare/vitest-pool-workers; nothing in src/ needs Node.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "55bf7202fe14474e57a300f56a652f64",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "RUN", "class_name": "RunDO" },
      { "name": "SINK", "class_name": "SinkDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlDO", "RunDO", "SinkDO"] }
  ],

  "r2_buckets": [{ "binding": "STORE", "bucket_name": "nf-telemetry" }],

  // Daily ControlDO snapshot to R2 (disaster recovery, spec §10).
  "triggers": { "crons": ["0 6 * * *"] },

  "vars": {
    // Claim not confirmed submitted within this window -> jobs return to pending.
    "CLAIM_TTL_MINUTES": "5",
    // Backstop for a run sitting in the scheduler queue with no wrapper yet.
    "SUBMIT_BACKSTOP_HOURS": "48",
    // No heartbeat for this long once the wrapper is alive -> presumed dead.
    "LIVENESS_MINUTES": "10",
    // Comma-separated browser origins allowed by CORS: the dashboard and Vite dev.
    "CORS_ORIGINS": "https://cmgd.cancerdatasci.org,http://localhost:5173",
    // POST /admin/reset empties every Durable Object and the R2 prefixes. Off in
    // production; the route fails closed on any value but "true", so removing the
    // var is also safe. Enable on a staging deploy with
    // `wrangler deploy --var ALLOW_RESET:true`. The test suite sets its own
    // ALLOW_RESET=true in vitest.config.ts.
    "ALLOW_RESET": "false"
    // CATALOG_URL: base of the catalog service's API (v1 mounts it at /api).
    // The eight historical-tier routes proxy GETs there and answer 501 while it
    // is unset or not answering. Set it once the catalog serves them (#211).
  }
  // Secrets (wrangler secret put): API_TOKEN — when set, bearer auth is
  // enforced on every mutating route except /telemetry (Nextflow's weblog
  // reporter cannot send auth headers).
}
