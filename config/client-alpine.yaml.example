# Installed at $NF_TEL_CONFIG. ${NAME} is expanded from the daemon's environment
# (~/.nf_tel.env, ~/.nf_tel.secrets); an unset variable fails the load.
server_url: "https://nf-telemetry.seandavi.workers.dev/api"
weblog_url: "https://nf-telemetry.seandavi.workers.dev/telemetry"
token: "${NF_OPERATOR_TOKEN}"

profile: "alpine,r2"   # R2 output (ADR 0008); needs ~/.nf_tel.r2 and Nextflow >= 25.04
continuous: true

dispatch:
  batch_size: 25
  workflow_id: "cmgd_nextflow"

submission:
  mode: slurm
  template_path: "${NF_TEL_REPO}/templates/submit_slurm.sh.j2"
  max_concurrent_runs: 10
  slurm_export_none: true    # Alpine leaks the login environment into jobs

  defaults:
    mem: "8G"
    cpus: 2
    time: "23:00:00"
    partition: "acpu"        # amilan was retired; acpu caps at 1 day
    qos: "cpu-normal"        # cpu-long allows 7 days
    account: "${NF_TEL_ACCOUNT}"
    log_dir: "${NF_TEL_LOGS}"
    publish_base: "s3://cmgd-raw"   # must match the r2 profile; results go to <base>/<workflow_id>/<version>/ (#220)
