# nf_telemetry directory layout — Purdue Anvil. Source from ~/.bash_profile.
# Same variable names on every cluster; only the values differ. See docs/hpc-layout.md.
export NF_TEL_CLUSTER=anvil

# ACCESS allocation charged for wrapper and task jobs. Project space is per
# allocation, so NF_TEL_HOME follows it: switching allocations means moving
# (or re-copying) $NF_TEL_STORE and $NF_TEL_DAEMON to the new project dir.
export NF_TEL_ACCOUNT=cis240955

# Persistent (/anvil/projects/x-<account>, 5T quota, never purged)
export NF_TEL_HOME=/anvil/projects/x-$NF_TEL_ACCOUNT/cmgd  # root: store, logs, nf_worker
export NF_TEL_STORE=$NF_TEL_HOME/store
export NF_TEL_LOGS=$NF_TEL_HOME/logs
export NF_TEL_DAEMON=$NF_TEL_HOME/nf_worker                # client yaml, daemon.log, pinned nextflow
export NF_TEL_CONFIG=$NF_TEL_DAEMON/client-anvil.yaml
export NF_TEL_REPO=$NF_TEL_DAEMON/nextflow_telemetry       # git checkout (templates/, config/)
# nxf_home stays on /home: scratch purges half-delete assets/ + plugins/ and every run aborts at clone.
export NF_TEL_NXF_HOME=$HOME/nxf_home

# Ephemeral (/anvil/scratch, purged; large + regenerable only)
export NF_TEL_SCRATCH=/anvil/scratch/x-seandavi/cmgd_data       # per-run launch dir = $NF_TEL_SCRATCH/$SLURM_JOB_ID

# Home (25G quota)
export NF_TEL_CREDS=$HOME/curatedmetagenomicdata-232f4a306d1d.json

# Loaded by the submit script before nextflow runs. Anvil offers only Java 8/11,
# so nextflow is pinned to the last Java-11 release via NXF_VER.
export NF_TEL_MODULES="openjdk/11.0.8_10"
export NXF_VER=23.10.1

export NXF_HOME=$NF_TEL_NXF_HOME
export NXF_SINGULARITY_CACHEDIR=$NF_TEL_SIF_CACHE
export PATH=$HOME/.local/bin:$NF_TEL_DAEMON:$PATH   # nf-client (uv tool), pinned nextflow launcher
