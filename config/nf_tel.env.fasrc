# nf_telemetry directory layout — Harvard FASRC (Cannon). Source from ~/.bash_profile.
# Same variable names on every cluster; only the values differ. See docs/hpc-layout.md.
export NF_TEL_CLUSTER=fasrc

# Default SLURM account for seandavi: the Huttenhower lab. FASRC schedules by
# fairshare, not billed units, so heavy use lowers the lab's priority (2026-11-05:
# FairShare 0.573). Wrapper on the lab's `huttenhower` partition (30 d), tasks
# on `hsph,shared` (3 d); see client-fasrc.yaml.
export NF_TEL_ACCOUNT=huttenhower_lab

# Lab storage (holylfs05: 50 TB lab quota, shared with the lab) for what must
# persist; netscratch (4 PB, purged) for run dirs.
export NF_TEL_HOME=/n/holylfs05/LABS/huttenhower_lab/Users/seandavi/cmgd  # root: store, logs, nf_worker
export NF_TEL_STORE=$NF_TEL_HOME/store
export NF_TEL_LOGS=$NF_TEL_HOME/logs
export NF_TEL_DAEMON=$NF_TEL_HOME/nf_worker                # daemon.log, pinned nextflow, jdk
export NF_TEL_REPO=$NF_TEL_DAEMON/nextflow_telemetry       # git checkout (templates/, config/)
export NF_TEL_CONFIG=$NF_TEL_REPO/config/client-fasrc.yaml # read in place; a checkout deploys it
export NF_TEL_NXF_HOME=$HOME/nxf_home                      # /n/home07, 95G

export NF_TEL_SCRATCH=/n/netscratch/huttenhower_lab/Lab/Users/seandavi/cmgd_data   # per-run launch dir = $NF_TEL_SCRATCH/$SLURM_JOB_ID
export NF_TEL_SIF_CACHE=$NF_TEL_HOME/singularity_cache   # persistent: netscratch purges would force rebuilds

# Legacy gcs profile only; never used with -profile r2.
export NF_TEL_CREDS=$HOME/curatedmetagenomicdata-232f4a306d1d.json

# System java is 1.8 and Nextflow >= 25.04 (needed for -profile r2, ADR 0008)
# wants 17+, so a user-space Temurin 21 JDK lives under $NF_TEL_DAEMON/jdk.
# singularity (CE 4.5) is on the default PATH (/usr/bin).
export NF_TEL_MODULES=""
export JAVA_HOME=$NF_TEL_DAEMON/jdk
export NXF_VER=25.10.8

export NXF_HOME=$NF_TEL_NXF_HOME
export NXF_SINGULARITY_CACHEDIR=$NF_TEL_SIF_CACHE
export PATH=$HOME/.local/bin:$NF_TEL_DAEMON:$JAVA_HOME/bin:$PATH   # nf-client (uv tool), pinned nextflow launcher, user-space JDK
