# nf_telemetry directory layout — PSC Bridges-2. Source from ~/.bash_profile.
# Same variable names on every cluster; only the values differ. See docs/hpc-layout.md.
export NF_TEL_CLUSTER=bridges2

# ACCESS allocation charged for wrapper and task jobs (RM-shared bills per core).
# bio260102p ("Uniform Metagenomic Profiling of Public Shotgun Sequencing Data",
# 700,000 SU, Ocean 2 TB, ends 2027-08-21) since 2026-10-17. cis260344p (10,000 SU)
# is a different project; cis260183p has no SUs.
export NF_TEL_ACCOUNT=bio260102p

# Bridges-2 has no purged scratch: everything sits on Ocean project space
# (2 TB quota for the whole allocation, 2026-10-17), so the run-dir cleanup in the
# submit template and the watchdog sweep are what keep it under quota.
export NF_TEL_HOME=/ocean/projects/$NF_TEL_ACCOUNT/seandavi/cmgd  # root: store, logs, nf_worker
export NF_TEL_STORE=$NF_TEL_HOME/store
export NF_TEL_LOGS=$NF_TEL_HOME/logs
export NF_TEL_DAEMON=$NF_TEL_HOME/nf_worker                # daemon.log, pinned nextflow, jdk
export NF_TEL_REPO=$NF_TEL_DAEMON/nextflow_telemetry       # git checkout (templates/, config/)
export NF_TEL_CONFIG=$NF_TEL_REPO/config/client-bridges2.yaml   # read in place; a checkout deploys it
export NF_TEL_NXF_HOME=$HOME/nxf_home                      # /jet/home, 25G quota

export NF_TEL_SCRATCH=/ocean/projects/$NF_TEL_ACCOUNT/seandavi/scratch/cmgd_data   # per-run launch dir = $NF_TEL_SCRATCH/$SLURM_JOB_ID
export NF_TEL_SIF_CACHE=/ocean/projects/$NF_TEL_ACCOUNT/seandavi/scratch/singularity_cache

# Legacy gcs profile only; never used with -profile r2.
export NF_TEL_CREDS=$HOME/curatedmetagenomicdata-232f4a306d1d.json

# System java is 1.8 and Nextflow >= 25.04 (needed for -profile r2, ADR 0008)
# wants 17+, so a user-space Temurin 21 JDK lives under $NF_TEL_DAEMON/jdk,
# as on Anvil. singularity/apptainer are on the default PATH (/usr/bin).
export NF_TEL_MODULES=""
export JAVA_HOME=$NF_TEL_DAEMON/jdk
export NXF_VER=25.10.8

export NXF_HOME=$NF_TEL_NXF_HOME
export NXF_SINGULARITY_CACHEDIR=$NF_TEL_SIF_CACHE
export PATH=$HOME/.local/bin:$NF_TEL_DAEMON:$JAVA_HOME/bin:$PATH   # nf-client (uv tool), pinned nextflow launcher, user-space JDK
