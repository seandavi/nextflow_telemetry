# nf_telemetry directory layout — CU Alpine. Source from ~/.bash_profile.
# Same variable names on every cluster; only the values differ. See docs/hpc-layout.md.
export NF_TEL_CLUSTER=alpine

# Persistent (/projects, 250G quota, never purged)
export NF_TEL_HOME=/projects/seda0001_amc/cmgd            # root: store, job logs
export NF_TEL_STORE=$NF_TEL_HOME/store                    # Nextflow storeDir (DBs, references)
export NF_TEL_LOGS=$NF_TEL_HOME/job_logs                  # slurm-*.out, nf-*.out, nextflow-*.log
export NF_TEL_DAEMON=/projects/seda0001_amc/nf_client     # daemon config, daemon.log, repo checkout
export NF_TEL_CONFIG=$NF_TEL_DAEMON/client-alpine.yaml
export NF_TEL_REPO=$NF_TEL_DAEMON/nextflow_telemetry      # git checkout (templates/ lives here)
export NF_TEL_NXF_HOME=/projects/seda0001_amc/nf_home     # NXF_HOME: assets, plugins (must not be purged)

# Ephemeral (/scratch, purged; large + regenerable only)
export NF_TEL_SCRATCH=/scratch/alpine/seda0001_amc/nf_worker   # per-run workDir = $NF_TEL_SCRATCH/$SLURM_JOB_ID
export NF_TEL_SIF_CACHE=/scratch/alpine/seda0001_amc/apptainer_cache

# Home (2G quota — nothing else goes here)
export NF_TEL_CREDS=$HOME/curatedmetagenomicdata-232f4a306d1d.json

export NXF_HOME=$NF_TEL_NXF_HOME
export NXF_SINGULARITY_CACHEDIR=$NF_TEL_SIF_CACHE
